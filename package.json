{
  "name": "wonder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gmail": "bash server/start_gmail.sh",
    "ai": "bash server/start_melani_ai.sh",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test:mel": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-mel-workspace.mts",
    "test:mel-protocol": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-mel-protocol.mts",
    "test:wardrobe": "node scripts/test-wardrobe-intelligence.mjs",
    "test:wardrobe-agent": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-wardrobe-agent.mts",
    "test:weather": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-weather-agent.mts",
    "test:care": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-care-concierge.mts",
    "preview": "vite preview",
    "test:finance": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-smart-accountant.mts",
    "test:finance-library": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-finance-library.mts",
    "test:rockefeller-finance": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-rockefeller-finance.mts",
    "test:business-report": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-business-report.mts",
    "test:tax": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-tax-knowledge.mts",
    "test:habits": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-habits.mts",
    "test:nutrition": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-nutrition.mts",
    "test:models": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-finance-models.mts",
    "test:trading": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-trading.mts",
    "test:care-agent": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-care-agent.mts",
    "test:quotes": "node --experimental-strip-types --experimental-loader ./scripts/ts-extension-loader.mjs scripts/test-quote-rotation.mts",
    "screen": "python3 scripts/screentime.py",
    "screen:watch": "python3 scripts/screentime.py --watch --disk --save --phone",
    "screen:week": "python3 scripts/screentime.py --days 7 --disk",
    "screen:export": "python3 scripts/screentime.py --export --days 30",
    "wonder:status": "bash scripts/wonder-keeper.sh status",
    "wonder:start": "bash scripts/wonder-keeper.sh start",
    "wonder:stop": "bash scripts/wonder-keeper.sh stop",
    "wonder:open": "bash scripts/wonder-keeper.sh open",
    "wonder:install": "bash scripts/wonder-keeper.sh install",
    "wonder:uninstall": "bash scripts/wonder-keeper.sh uninstall"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@unpic/react": "^1.0.2",
    "bplist-parser": "^0.3.2",
    "epubjs": "^0.3.93",
    "ipx": "^3.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  }
}
